From: Harlan Lieberman-Berg <hlieberman@debian.org>
Date: Sun, 4 Nov 2018 21:34:10 +0800
Subject: Ensure jq doesn't statically link in libraries

Forwarded: not-needed
---
 Makefile.am | 5 ++---
 tests/setup | 6 +++---
 2 files changed, 5 insertions(+), 6 deletions(-)

diff --git a/Makefile.am b/Makefile.am
index cd16690..edf7cf4 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -105,8 +105,7 @@ src/builtin.inc: src/builtin.jq
 src/builtin.o: src/builtin.inc
 
 bin_PROGRAMS = jq
-jq_SOURCES = src/main.c src/version.h
-jq_LDFLAGS = -static-libtool-libs
+jq_SOURCES = main.c version.h
 jq_LDADD = libjq.la -lm
 
 if WIN32
@@ -114,7 +113,7 @@ jq_LDADD += -lshlwapi
 endif
 
 if ENABLE_ALL_STATIC
-jq_LDFLAGS += -all-static
+jq_LDFLAGS = -all-static
 endif
 
 ### Tests (make check)
diff --git a/tests/setup b/tests/setup
index 4a96574..e000637 100755
--- a/tests/setup
+++ b/tests/setup
@@ -13,9 +13,9 @@ JQBASEDIR=$JQTESTDIR/..
 JQ=$JQBASEDIR/jq
 
 if [ -z "${NO_VALGRIND-}" ] && which valgrind > /dev/null; then
-    VALGRIND="valgrind --error-exitcode=1 --leak-check=full \
-                       --suppressions=$JQTESTDIR/onig.supp"
-    VG_EXIT0=--error-exitcode=0
+    VALGRIND="libtool --mode=execute -- valgrind \
+    		      	       --error-exitcode=1 --leak-check=full \
+		      	       --suppressions=$JQTESTDIR/onig.supp"
     Q=-q
 else
     VALGRIND=
