Description: Do not distribute COPYING, fixes lintian warning
Author: Simon Elsbrock
Forwarded: not-needed
Last-Update: 2015-10-11
---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
Index: jq/Makefile.am
===================================================================
--- jq.orig/Makefile.am	2015-10-11 12:48:00.000000000 +0200
+++ jq/Makefile.am	2015-10-11 12:49:14.103752183 +0200
@@ -169,7 +169,7 @@
 # README.md is expected in Github projects, good stuff in it, so we'll 
 # distribute it and install it with the package in the doc directory.
 docdir = ${datadir}/doc/${PACKAGE}
-dist_doc_DATA = README.md COPYING AUTHORS README
+dist_doc_DATA = README.md AUTHORS README
 
 RELEASE ?= 1
 rpm: dist jq.spec
